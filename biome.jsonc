{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/tanstack",
    "ultracite/biome/vitest"
  ],
  // Generated by the shadcn CLI and regenerated on upgrade. Biome must not touch
  // these: `ultracite fix` has been observed to corrupt combobox.tsx by duplicating
  // a JSX attribute. Linting them is pointless too - the findings could only ever be
  // resolved by editing vendored code.
  "files": {
    "includes": [
      "!**/components/ui",
      "!**/hooks/use-mobile.ts",
      // Installed skill templates (skills-lock.json), not this repo's code.
      "!.agents",
      "!.claude/skills"
    ]
  },
  "linter": {
    "rules": {
      // Inline arrow handlers are idiomatic React 19 and the compiler-era
      // guidance; wrapping every onClick in useCallback obscures the code.
      "performance": { "noJsxPropsBind": "off" },
      // Biome's type inference does not see through useState<T | null> and
      // useRef<T | null>, so this rule flags every real null check as unnecessary.
      "suspicious": { "noUnnecessaryConditions": "off" }
    }
  }
}
